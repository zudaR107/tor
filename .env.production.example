# Production example - copy to .env and fill in your real domain.
#
# Point DNS A/AAAA records for these four hostnames at this server before
# starting the stack, so Caddy can complete the ACME HTTP-01 challenge and
# get real Let's Encrypt certificates for each of them:
#   example.com
#   auth.example.com
#   kuvert.example.com
#   tafel.example.com
DOMAIN=example.com

# schlussel API - CORS allowlist. Named per-service (not plain
# ALLOWED_ORIGINS) because this file provides one shared .env for every
# included service's compose file - see .env.example for why.
SCHLUSSEL_ALLOWED_ORIGINS=https://example.com,https://auth.example.com,https://kuvert.example.com,https://tafel.example.com

# kuvert-api - CORS allowlist (see the naming note above)
KUVERT_ALLOWED_ORIGINS=https://example.com,https://kuvert.example.com

# tafel-api - CORS allowlist (see the naming note above)
TAFEL_ALLOWED_ORIGINS=https://example.com,https://tafel.example.com

# schlussel-web - return_to origin allowlist, and where a visitor who
# opened /login or /register directly (no return_to) gets sent instead
ALLOWED_RETURN_ORIGINS=https://example.com,https://kuvert.example.com,https://tafel.example.com
DEFAULT_APP_URL=https://example.com

# schloss - where its Kuvert/Tafel cards link to, and where its "Войти"
# button and unauthenticated-visitor redirect point
KUVERT_URL=https://kuvert.example.com
TAFEL_URL=https://tafel.example.com
SCHLUSSEL_WEB_URL=https://auth.example.com

# kuvert-web/tafel-web - where an unauthenticated visitor gets redirected
# to log in (both reuse the same SCHLUSSEL_WEB_URL value as schloss
# above), and where their header's "На главную" link points back to
SCHLOSS_URL=https://example.com
